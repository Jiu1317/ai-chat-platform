{
  "chrome": {
    "cdp_host": "127.0.0.1",
    "cdp_port": 9332,
    "user_data_dir": "runtime/profiles/worker-template",
    "binary": null,
    "auto_launch": true,
    "startup_timeout_seconds": 30,
    "page_url": "https://chat.deepseek.com/"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 9192,
    "api_keys": [
      "REPLACE_WITH_A_LONG_RANDOM_API_KEY"
    ],
    "request_timeout_seconds": 600,
    "poll_interval_seconds": 0.25,
    "stable_polls": 3,
    "max_request_bytes": 31457280
  },
  "deepseek": {
    "default_model": "deepseek-chat",
    "models": [
      "deepseek-chat",
      "deepseek-reasoner"
    ]
  }
}
