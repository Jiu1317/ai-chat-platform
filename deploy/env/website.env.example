# Copy this file to /etc/ai-chat/website.env and replace every CHANGE_ME value.
AI_CHAT_ADMIN_USERNAME=admin
AI_CHAT_ACCESS_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AI_CHAT_SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARACTERS

# Signed reference-image transfer to Web2API (never commit real values).
AI_CHAT_PUBLIC_BASE_URL=https://chat.example.com
AI_CHAT_TRANSFER_SECRET=CHANGE_ME_SEPARATE_RANDOM_64_HEX_CHARACTERS


AI_CHAT_DATA_DIR=/srv/ai-chat/data
AI_CHAT_WORKSPACE_ROOT=/srv/ai-chat/workspaces
CODEX_HOME=/srv/ai-chat/data/codex
CODEX_BIN=codex

# Optional local OpenAI-compatible upstream used by the site's /v1 endpoint.
AI_CHAT_UPSTREAM_URL=http://127.0.0.1:9000
AI_CHAT_RESTRICTED_API_KEY=
AI_CHAT_RESTRICTED_API_MODEL=gpt-5.3-codex-spark

# Optional image bridge. The token must match image-bridge.env.
AI_CHAT_IMAGE_BRIDGE_URL=http://127.0.0.1:13003
AI_CHAT_IMAGE_BRIDGE_TOKEN=CHANGE_ME_IMAGE_BRIDGE_TOKEN
