[Unit]
Description=AI Chat image generation bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-chat
Group=ai-chat
WorkingDirectory=/srv/ai-chat/current/services/image-bridge
EnvironmentFile=/etc/ai-chat/image-bridge.env
ExecStart=/usr/bin/node /srv/ai-chat/current/services/image-bridge/image-bridge.mjs
Restart=on-failure
RestartSec=3
# The bridge drains active generation/download requests for up to 19m30s.
# Keep systemd's deadline slightly above the bridge's own bounded fallback.
TimeoutStopSec=20min
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
